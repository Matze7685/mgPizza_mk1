{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    "%% = share of the tomato weight. g / ml / pcs / tsp = amount for all %lld pizzas, scales when you change the pizza count. Tip: Neapolitan style uses only crushed raw tomatoes + ~1.5–2%% salt; basil and oil go on the pizza." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%% = Anteil an der Tomatenmenge. g / ml / Stk. / TL = Menge für alle %lld Pizzen, wird bei Änderung der Pizza-Anzahl hochgerechnet. Tipp: Neapolitanisch nur rohe, zerdrückte Tomaten + ~1,5–2 %% Salz; Basilikum und Öl kommen auf die Pizza."
          }
        }
      }
    },
