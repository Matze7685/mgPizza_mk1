    },
    "%@: get ready to take the dough out of the fridge." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Bereite dich vor, den Teig aus dem Kühlschrank zu nehmen."
