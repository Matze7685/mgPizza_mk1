    },
    "%@: take the dough out of the fridge and portion it into balls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Teig aus dem Kühlschrank nehmen und in Teiglinge portionieren."
