    "%@: take the dough out of the fridge and portion it now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Jetzt den Teig aus dem Kühlschrank nehmen und portionieren."
